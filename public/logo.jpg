<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <defs>
    <!-- Premium Silver Gradient -->
    <linearGradient id="silver" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="20%" stop-color="#e5e7eb"/>
      <stop offset="50%" stop-color="#9ca3af"/>
      <stop offset="80%" stop-color="#6b7280"/>
      <stop offset="100%" stop-color="#374151"/>
    </linearGradient>

    <!-- Outer Glow -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <rect width="100" height="100" rx="20" fill="#050505" stroke="url(#silver)" stroke-width="2"/>
  
  <g transform="translate(25, 25)" filter="url(#glow)">
    <path d="M10 25 L25 10 L40 25" fill="none" stroke="url(#silver)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M10 25 L40 25 M25 10 L25 45" fill="none" stroke="url(#silver)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="25" cy="25" r="4" fill="#ffffff" />
  </g>
</svg>
